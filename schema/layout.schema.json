{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlateUp Layout Document",
  "type": "object",
  "required": [
    "version",
    "appliances"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "origin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "appliances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "x",
          "y",
          "rotation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "state": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": false
}
